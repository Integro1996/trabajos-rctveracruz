DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Conservar Authorization bajo Apache/FastCGI y evitar reescribir el front controller sobre si mismo.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api/index\.php$ - [L]

  # API PHP y recuperación QR: nunca enviar estas rutas al index.html de React.
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]
  RewriteRule ^recover(?:/.*)?$ api/index.php [QSA,L]
  RewriteRule ^health$ api/index.php [QSA,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback SPA para /admin y demás rutas de React.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
